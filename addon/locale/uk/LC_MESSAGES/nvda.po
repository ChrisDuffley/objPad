#. Translators: This is the label for the ObjPad settings panel.
#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: addon\globalPlugins\objPad.py:44 buildVars.py:21
msgid "ObjPad"
msgstr "ObjPad"

#. Translators: input help mode message for ObjPad toggle command.
#: addon\globalPlugins\objPad.py:85
msgid "Toggles ObjPad mode between normal, object nav, browse mode elements, and scan modes"
msgstr "Toggles ObjPad mode between normal, object nav, browse mode elements, and scan modes"

#. Translators: one of the object arrow modes.
#: addon\globalPlugins\objPad.py:93
msgid "Object nav mode"
msgstr "Режим об’єктної навігації"

#. Translators: one of the object arrow modes.
#: addon\globalPlugins\objPad.py:97
msgid "Browse mode"
msgstr "Режим огляду"

#. Translators: one of the object arrow modes.
#: addon\globalPlugins\objPad.py:101
msgid "Scan mode"
msgstr "Режим сканування"

#. Translators: one of the object arrow modes.
#: addon\globalPlugins\objPad.py:105
msgid "Normal mode"
msgstr "Звичайний режим"

#: addon\globalPlugins\objPad.py:128
msgid "default"
msgstr "початково"

#: addon\globalPlugins\objPad.py:129
msgid "headings"
msgstr "заголовки"

#: addon\globalPlugins\objPad.py:130
msgid "tables"
msgstr "таблиці"

#: addon\globalPlugins\objPad.py:131
msgid "links"
msgstr "посилання"

#: addon\globalPlugins\objPad.py:132
msgid "form fields"
msgstr "поля форми"

#: addon\globalPlugins\objPad.py:133
msgid "lists"
msgstr "списки"

#: addon\globalPlugins\objPad.py:134
msgid "frames"
msgstr "фрейми"

#: addon\globalPlugins\objPad.py:136
msgid "landmarks"
msgstr "орієнтири"

#: addon\globalPlugins\objPad.py:137
msgid "embedded objects"
msgstr "вбудовані об'єкти"

#: addon\globalPlugins\objPad.py:138
msgid "text paragraphs"
msgstr "абзаци"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:24
msgid "Perform various NVDA object commands by pressing a single key, including navigation and more."
msgstr "Perform various NVDA object commands by pressing a single key, including navigation and more."

#. Brief changelog for this version
#. Translators: what's new content for the add-on version to be shown in the add-on store
#: buildVars.py:29
msgid "* Removed add-on changelog from add-on help (readme) file.\n"
"* If running NVDA 2026.2, add-on browse mode elements will be limited to default (all elements), headings, tables, links, form fields, and lists. On touchscreen computers, additional browse mode elements can be added via NVDA's browse mode settings.\n"
"* The \"default (all elements)\" mode in browse mode is now called \"default\" mode to match messaging from NVDA 2026.2's touch browse mode.\n"
"* Added graphics navigation to browse mode (NVDA 2025.3.3 and 2026.1)."
msgstr "* Removed add-on changelog from add-on help (readme) file.\n"
"* If running NVDA 2026.2, add-on browse mode elements will be limited to default (all elements), headings, tables, links, form fields, and lists. On touchscreen computers, additional browse mode elements can be added via NVDA's browse mode settings.\n"
"* The \"default (all elements)\" mode in browse mode is now called \"default\" mode to match messaging from NVDA 2026.2's touch browse mode.\n"
"* Added graphics navigation to browse mode (NVDA 2025.3.3 and 2026.1)."

