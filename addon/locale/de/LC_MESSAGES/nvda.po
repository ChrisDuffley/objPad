#. Translators: This is the label for the ObjPad settings panel.
#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: addon\globalPlugins\objPad.py:39 buildVars.py:21
msgid "ObjPad"
msgstr "ObjPad"

#. Translators: Label for the list of browse mode navigation element types in ObjPad settings.
#: addon\globalPlugins\objPad.py:49
msgid "&Browse mode navigation elements:"
msgstr "&Browse mode navigation elements:"

#. Translators: input help mode message for ObjPad toggle command.
#: addon\globalPlugins\objPad.py:81
msgid "Toggles ObjPad mode between normal, object nav, browse mode elements, and scan modes"
msgstr "Toggles ObjPad mode between normal, object nav, browse mode elements, and scan modes"

#. Translators: one of the object arrow modes.
#: addon\globalPlugins\objPad.py:89
msgid "Object nav mode"
msgstr "Objektnavigationsmodus"

#. Translators: one of the object arrow modes.
#: addon\globalPlugins\objPad.py:93
msgid "Browse mode"
msgstr "Browse mode"

#. Translators: one of the object arrow modes.
#: addon\globalPlugins\objPad.py:97
msgid "Scan mode"
msgstr "Erkundungsmodus"

#. Translators: one of the object arrow modes.
#: addon\globalPlugins\objPad.py:101
msgid "Normal mode"
msgstr "Normalmodus"

#. Translators: input help mode message for ObjPad toggle command.
msgid "Toggles ObjPad mode between normal, object nav and scan modes"
msgstr "Schaltet zwischen Normal-, Objektnavigations- und Erkundungsmodus um"

#. Web navigation:
#. Web elements list:
msgid "normal"
msgstr "normal"

msgid "Link"
msgstr "Link"

msgid "Form field"
msgstr "Formularfeld"

msgid "Heading"
msgstr "Überschrift"

msgid "Frame"
msgstr "Rahmen"

msgid "Table"
msgstr "Tabelle"

msgid "List"
msgstr "Liste"

msgid "Landmark"
msgstr "Sprungmarke"

#. Translators: a message when there is no next object when navigating
#: addon\globalPlugins\objPad.py:179
msgid "No next"
msgstr "Keine weiteren Objekte"

#. Translators: a message when there is no previous object when navigating
#: addon\globalPlugins\objPad.py:213
msgid "No previous"
msgstr "Keine vorherigen Objekte"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-ons manager
msgid ""
"Perform various object commands by pressing a single key, including "
"navigation and more"
msgstr ""
"Führen Sie verschiedene Objektbefehle mit nur einem Tastendruck aus, "
"einschließlich Navigation und mehr"
