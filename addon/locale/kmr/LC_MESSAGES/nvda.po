#. Translators: This is the label for the ObjPad settings panel.
#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: addon\globalPlugins\objPad.py:44 buildVars.py:21
msgid "ObjPad"
msgstr "ObjPadName"

#. Translators: input help mode message for ObjPad toggle command.
#: addon\globalPlugins\objPad.py:85
msgid "Toggles ObjPad mode between normal, object nav, browse mode elements, and scan modes"
msgstr "Moda ObjPad di navbera modên normal, navîgasyona objektê, hêmanên moda gerokê, û modên skenkirinê de diguherîne"

#. Translators: one of the object arrow modes.
#: addon\globalPlugins\objPad.py:93
msgid "Object nav mode"
msgstr "Moda navîgasyona tiştan"

#. Translators: one of the object arrow modes.
#: addon\globalPlugins\objPad.py:97
msgid "Browse mode"
msgstr "Moda geroka înternetê"

#. Translators: one of the object arrow modes.
#: addon\globalPlugins\objPad.py:101
msgid "Scan mode"
msgstr "Moda skenkirinê"

#. Translators: one of the object arrow modes.
#: addon\globalPlugins\objPad.py:105
msgid "Normal mode"
msgstr "Moda normal"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:24
msgid "Perform various NVDA object commands by pressing a single key, including navigation and more."
msgstr "Fermanên cûrbecûr ên objeyên NVDA bi tikandina bişkojkekê pêk bînin, tevî navîgasyon û hêj bêtir."

#. Brief changelog for this version
#. Translators: what's new content for the add-on version to be shown in the add-on store
#: buildVars.py:29
msgid "* NVDA 2026.2 (64-bit) or later is required."
msgstr "* NVDA 2026.2 (64-bit) an jî guhertoyek nûtir pêwîst e."

