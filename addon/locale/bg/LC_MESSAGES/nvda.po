#. Translators: This is the label for the AudioScreen settings panel.
#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: addon\globalPlugins\objPad.py:39 buildVars.py:21
msgid "ObjPad"
msgstr "ObjPad"

#. Translators: Label for the list of browse mode navigation element types in ObjPad settings.
#: addon\globalPlugins\objPad.py:49
msgid "&Browse mode navigation elements:"
msgstr "&Елементи за навигиране в режим на разглеждане:"

#. Translators: input help mode message for ObjPad toggle command.
#: addon\globalPlugins\objPad.py:81
msgid "Toggles ObjPad mode between normal, object nav, browse mode elements, and scan modes"
msgstr "Превключва режима на ObjPad между нормален, обектна навигация, елементи в режим на разглеждане и режим на сканиране"

#. Translators: one of the object arrow modes.
#: addon\globalPlugins\objPad.py:89
msgid "Object nav mode"
msgstr "Режим на обектна навигация"

#. Translators: one of the object arrow modes.
#: addon\globalPlugins\objPad.py:93
msgid "Browse mode"
msgstr "Режим на разглеждане"

#. Translators: one of the object arrow modes.
#: addon\globalPlugins\objPad.py:97
msgid "Scan mode"
msgstr "Режим на сканиране"

#. Translators: one of the object arrow modes.
#: addon\globalPlugins\objPad.py:101
msgid "Normal mode"
msgstr "Нормален режим"

#. Translators: a message when there is no next object when navigating
#: addon\globalPlugins\objPad.py:179
msgid "No next"
msgstr "Няма следващ"

#. Translators: a message when there is no previous object when navigating
#: addon\globalPlugins\objPad.py:213
msgid "No previous"
msgstr "Няма предишен"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:24
msgid "Perform various NVDA object commands by pressing a single key, including navigation and more."
msgstr "Изпълнявайте различни обектни команди на NVDA чрез натискане само на един клавиш, включително навигация и други."

#. Brief changelog for this version
#. Translators: what's new content for the add-on version to be shown in the add-on store
#: buildVars.py:29
msgid "* NVDA 2026.2 or later is required."
msgstr "* Изисква се NVDA 2026.2 или по-нова версия."

